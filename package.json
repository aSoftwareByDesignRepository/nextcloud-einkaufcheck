{
  "name": "einkaufcheck",
  "private": true,
  "description": "EinkaufCheck Nextcloud app — Playwright a11y / pictures / offers gauntlet",
  "scripts": {
    "e2e": "playwright test --workers=1",
    "e2e:a11y": "playwright test e2e/a11y-smoke.spec.js --workers=1",
    "e2e:theme": "playwright test e2e/theme-responsive-a11y.spec.js --workers=1",
    "e2e:visual": "playwright test e2e/visual-regression.spec.js --workers=1",
    "e2e:pictures": "playwright test e2e/pictures-journey.spec.js --workers=1",
    "e2e:offers": "playwright test e2e/offers-journey.spec.js --workers=1",
    "e2e:install": "playwright install chromium",
    "e2e:prep": "bash scripts/e2e-prep.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.56.1"
  }
}
